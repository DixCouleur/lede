--- /dev/null
+++ b/root/usr/share/AdGuardHome/ax6000-ui-prepare.rb
@@ -0,0 +1,29 @@
+#!/usr/bin/ruby
+# Apply LuCI Web settings to the current AdGuard Home YAML schema.
+require 'yaml'
+path, host, port, password_hash = ARGV
+raise 'Invalid Web port' unless port.to_s.match?(/\A[0-9]+\z/) && (1..65535).cover?(port.to_i)
+raise 'Invalid Web address' unless host.to_s.match?(/\A[0-9a-fA-F:.]+\z/)
+document = Psych.parse_stream(File.read(path))
+pending = [document]
+until pending.empty?
+  node = pending.shift
+  if node.is_a?(Psych::Nodes::Scalar) && node.plain && node.value.start_with?(':')
+    node.plain = false
+    node.quoted = true
+    node.style = Psych::Nodes::Scalar::DOUBLE_QUOTED
+  end
+  pending.concat(node.children || [])
+end
+config = YAML.safe_load(document.to_yaml, permitted_classes: [Time], aliases: true)
+address = host.include?(':') ? "[#{host}]:#{port}" : "#{host}:#{port}"
+(config['http'] ||= {})['address'] = address
+unless password_hash.to_s.empty?
+  raise 'Expected a bcrypt password hash' unless password_hash.match?(/\A\$2[aby]\$[0-9]{2}\$.{53}\z/)
+  users = config['users'] ||= []
+  users << {'name' => 'root'} if users.empty?
+  users.first['password'] = password_hash
+end
+File.write(path + '.ui-tmp', YAML.dump(config))
+File.chmod(0600, path + '.ui-tmp')
+File.rename(path + '.ui-tmp', path)
