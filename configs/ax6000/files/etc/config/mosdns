config mosdns 'config'
	option enabled '1'
	option configfile '/etc/mosdns/config_custom.yaml'
	option listen_port '5335'
	option listen_address '127.0.0.1'
	option redirect '0'
	option local_dns_redirect '0'
	option geo_auto_update '0'
	option adblock '0'
	option ax6000_split '1'
	option log_level 'error'
	option log_file '/var/log/mosdns.log'
	option log_size '1'
	option listen_port_api '9091'
	option stats_collector '1'
	option stats_capacity '500'
