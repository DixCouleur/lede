+++ b/feeds/luci/applications/luci-app-openclash/root/etc/init.d/openclash
@@ -4,6 +4,17 @@
 START=99
 STOP=15
 USE_PROCD=1
+
+# Gate before rc.common takes procd's lock; validator children already own it.
+if [ -z "$IPKG_INSTROOT" ] && [ "${AX6000_CORE_CHECK:-0}" != 1 ]; then
+   case "$action" in
+      start|stop|restart|reload|boot|shutdown)
+         mkdir -p /tmp/lock
+         exec 885>/tmp/lock/openclash-core-operation.lock
+         flock -x 885
+         ;;
+   esac
+fi
 
 . $IPKG_INSTROOT/usr/share/openclash/openclash_ps.sh
 . $IPKG_INSTROOT/usr/share/openclash/ruby.sh
