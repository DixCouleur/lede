--- a/feeds/luci/applications/luci-app-mosdns/Makefile
+++ b/feeds/luci/applications/luci-app-mosdns/Makefile
@@ -6,7 +6,7 @@
 
 LUCI_TITLE:=LuCI Support for mosdns
 LUCI_PKGARCH:=all
-LUCI_DEPENDS:=+mosdns +uclient-fetch +v2ray-geoip +v2ray-geosite +geo2txt +ucode
+LUCI_DEPENDS:=+mosdns +uclient-fetch +geo2txt +ucode
 
 PKG_MAINTAINER:=sbwml <admin@cooluc.com>
 
--- a/feeds/luci/applications/luci-app-mosdns/root/etc/init.d/mosdns
+++ b/feeds/luci/applications/luci-app-mosdns/root/etc/init.d/mosdns
@@ -834,12 +834,15 @@
 
 	rm -rf /tmp/log/mosdns*
 
-	$MOSDNS_SCRIPT v2dat_dump
+	# Custom profiles using bundled text rules need no full geodata database.
+	if [ "${CONF}" = "/var/etc/mosdns.json" ] || [ -n "$(uci -q get mosdns.config.geosite_tags)$(uci -q get mosdns.config.geoip_tags)" ]; then
+		$MOSDNS_SCRIPT v2dat_dump
+	fi
 
 	[ "${CONF}" = "/var/etc/mosdns.json" ] && generate_config
 
 	procd_open_instance mosdns
-	procd_set_param env QUIC_GO_DISABLE_RECEIVE_BUFFER_WARNING=true
+	procd_set_param env QUIC_GO_DISABLE_RECEIVE_BUFFER_WARNING=true GOGC=50 GOMEMLIMIT=33554432
 	procd_set_param command $PROG start
 	procd_append_param command -c "$CONF"
 	procd_append_param command -d "/etc/mosdns"
@@ -854,7 +857,7 @@
 
 	# dns hijack
 	if [ "$local_dns_redirect" -eq 1 ] && [ -f "/sbin/fw4" ]; then
-		! nft --check list table inet mosdns > "/dev/null" 2>&1 || \
+		command -v nft >/dev/null 2>&1 && ! nft --check list table inet mosdns > "/dev/null" 2>&1 || \
 			nft delete table inet mosdns
 		nft add table inet mosdns
 		nft add chain inet mosdns prerouting "{ type nat hook prerouting priority -95; policy accept; }"
@@ -886,7 +889,7 @@
 	config_load "mosdns"
 	config_foreach get_config "mosdns"
 	[ "$enabled" -eq "0" ] && restore_dhcp_setting
-	! nft --check list table inet mosdns > "/dev/null" 2>&1 || \
+	command -v nft >/dev/null 2>&1 && ! nft --check list table inet mosdns > "/dev/null" 2>&1 || \
 		nft delete table inet mosdns
 	reload_dnsmasq
 	delcron
