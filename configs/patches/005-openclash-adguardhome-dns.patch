--- a/feeds/luci/applications/luci-app-openclash/root/etc/init.d/openclash
+++ b/feeds/luci/applications/luci-app-openclash/root/etc/init.d/openclash
@@ -177,6 +177,9 @@
 }
 
 change_dnsmasq() {
+   local dnsmasq_redirect="$1"
+   # Keep AdGuard Home on port 53 while switching its dnsmasq backend.
+   [ "$(uci_get_config "adguardhome_dns")" = "1" ] && dnsmasq_redirect=1
    if ! /etc/init.d/dnsmasq enabled; then
       return
    fi
@@ -187,7 +190,7 @@
    # 第二 DNS 服务
    /usr/share/openclash/openclash_custom_domain_dns.sh
 
-   if [ "$1" -eq 1 ]; then
+   if [ "$dnsmasq_redirect" -eq 1 ]; then
       if [ "$(uci_get_config "redirect_dns")" != "1" ]; then
          uci -q del openclash.config.dnsmasq_server
          config_load "dhcp"
@@ -211,7 +214,7 @@
       uci -q set openclash.config.cachesize_dns=0
    fi
 
-   if [ "$1" -eq 1 ] && [ "$ipv6_dns" -eq 1 ] && [ -n "$(ip6tables -t mangle -L 2>&1 | grep -o 'Chain')" ]; then
+   if [ "$dnsmasq_redirect" -eq 1 ] && [ "$ipv6_dns" -eq 1 ] && [ -n "$(ip6tables -t mangle -L 2>&1 | grep -o 'Chain')" ]; then
       #dnsmasq answer ipv6
       uci -q set openclash.config.dnsmasq_filter_aaaa="$(uci -q get dhcp.@dnsmasq[0].filter_aaaa)"
       uci -q set dhcp.@dnsmasq[0].filter_aaaa=0
